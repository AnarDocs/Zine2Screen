#!/bin/bash
# bookWiz — PDF booklet conversion wrapper

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    echo "Usage:"
    echo "  bookWiz -tobook     input.pdf [output.pdf] [flip] [half]  Reading-order pages → imposed booklet"
    echo "  bookWiz -totrifold  input.pdf [output.pdf] [half]         6 reading-order pages → trifold layout"
    echo "  bookWiz -tofourfold input.pdf [output.pdf] [half]         4 reading-order pages → fourfold layout"
    echo "  bookWiz -frombook   input.pdf [output.pdf]                Imposed booklet → reading-order pages"
    echo "  bookWiz -fromscan   input.pdf [output.pdf]                Scanned spreads → reading-order pages"
    echo "  bookWiz -scan2book  input.pdf [output.pdf] [flip]         Scanned spreads → imposed booklet"
    echo "  bookWiz -toA4       input.pdf [output.pdf]                Rescale Letter-imposed booklet → A4"
    echo "  bookWiz -toLetter   input.pdf [output.pdf]                Rescale A4-imposed booklet → Letter"
    echo ""
    echo "  flip   Rotate odd sheets 180° for short-edge duplex printers (booklet only)"
    echo "  half   Scale pages down by 1/√2 before imposition (A4→A5, A5→A6, etc.)"
    exit 1
}

if [ $# -lt 2 ]; then
    usage
fi

command="$1"
input="$2"
shift 2

if [ ! -f "$input" ]; then
    echo "Error: Input file not found: $input"
    exit 1
fi

stem=$(basename "$input" .pdf)
output=""
flip=false
half=false

for arg in "$@"; do
    case "$arg" in
        flip|-flip) flip=true ;;
        half|-half) half=true ;;
        *.pdf)      output="$arg" ;;
        *)          echo "Unknown argument: $arg"; usage ;;
    esac
done

case "$command" in

    -tobook)
        output="${output:-${stem}-booklet.pdf}"
        flip_arg=""; half_arg=""
        [ "$flip" == "true" ] && flip_arg="--flip-even"
        [ "$half" == "true" ] && half_arg="--half"
        echo "Converting $input → imposed booklet → $output"
        python3 "$SCRIPT_DIR/screen2zine.py" "$input" -o "$output" --format booklet --binding-margin 0 --outer-margin 0 $flip_arg $half_arg
        ;;

    -totrifold)
        output="${output:-${stem}-trifold.pdf}"
        half_arg=""
        [ "$half" == "true" ] && half_arg="--half"
        echo "Converting $input → trifold → $output"
        python3 "$SCRIPT_DIR/screen2zine.py" "$input" -o "$output" --format trifold $half_arg
        ;;

    -tofourfold)
        output="${output:-${stem}-fourfold.pdf}"
        half_arg=""
        [ "$half" == "true" ] && half_arg="--half"
        echo "Converting $input → fourfold → $output"
        python3 "$SCRIPT_DIR/screen2zine.py" "$input" -o "$output" --format fourfold $half_arg
        ;;

    -frombook)
        output="${output:-${stem}-screen.pdf}"
        echo "Converting $input → reading order → $output"
        "$SCRIPT_DIR/zine2screen.sh" -o "$output" "$input"
        ;;

    -fromscan)
        output="${output:-${stem}-screen.pdf}"
        echo "Converting $input → reading order → $output"
        tmp_dir=$(mktemp -d)
        "$SCRIPT_DIR/splitSpread.sh" -c "-o=${tmp_dir}" "$input"
        mv "${tmp_dir}/${stem}-compiled.pdf" "$output"
        rm -rf "$tmp_dir"
        ;;

    -scan2book)
        output="${output:-${stem}-booklet.pdf}"
        flip_arg=""
        [ "$flip" == "true" ] && flip_arg="--flip-even"
        echo "Converting $input → split → impose → $output"
        tmp_dir=$(mktemp -d)
        "$SCRIPT_DIR/splitSpread.sh" -c "-o=${tmp_dir}" "$input"
        python3 "$SCRIPT_DIR/screen2zine.py" "${tmp_dir}/${stem}-compiled.pdf" -o "$output" --binding-margin 0 --outer-margin 0 $flip_arg
        rm -rf "$tmp_dir"
        ;;

    -toA4)
        output="${output:-${stem}-A4.pdf}"
        echo "Converting $input → A4 imposed → $output"
        python3 "$SCRIPT_DIR/screen2zine.py" "$input" -o "$output" --convert-to A4
        ;;

    -toLetter)
        output="${output:-${stem}-letter.pdf}"
        echo "Converting $input → Letter imposed → $output"
        python3 "$SCRIPT_DIR/screen2zine.py" "$input" -o "$output" --convert-to letter
        ;;

    *)
        echo "Unknown command: $command"
        usage
        ;;

esac
